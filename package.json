{
  "name": "secondmind-local",
  "version": "0.1.0",
  "description": "Private local folder retrieval for AI clients on Windows",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "bin": {
    "secondmind": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs/architecture.md",
    "docs/security.md",
    "docs/integrations.md",
    "docs/verification.md"
  ],
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "pretest:ui": "npm run build",
    "test:ui": "playwright test",
    "test:package": "tsx scripts/package-smoke.ts",
    "smoke": "tsx scripts/smoke.ts",
    "evaluate": "tsx scripts/evaluate.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "prepack": "npm run build",
    "release": "tsx scripts/release.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "@iarna/toml": "2.2.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "chokidar": "^4.0.3",
    "express": "^5.1.0",
    "ignore": "^7.0.5",
    "js-tiktoken": "^1.0.21",
    "mammoth": "1.12.3",
    "pdfjs-dist": "6.3.289",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rehype-parse": "^9.0.1",
    "remark-parse": "^11.0.0",
    "sqlite-vec": "0.1.9",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "yauzl": "^3.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.25.12",
    "prettier": "^3.9.8",
    "tsx": "^4.20.6",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
